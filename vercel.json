{
  "version": 2,
  "name": "scip-web",
  "buildCommand": "npm --prefix apps/web install && npm --prefix apps/web run build",
  "installCommand": "npm --prefix apps/web install",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://scip-api.onrender.com/api/$1",
      "headers": { "X-Requested-With": "XMLHttpRequest" }
    },
    {
      "src": "/((?!assets/|shield\\.svg).*)",
      "dest": "/"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://scip-api.onrender.com/api"
  }
}
